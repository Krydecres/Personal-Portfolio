<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.portfolio</groupId>
    <artifactId>portfolio-backend</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Portfolio Backend (SOA)</name>
    <description>
        Personal portfolio backend organised as independent services
        (identity, profile, content) composed into one Spring Boot application.
    </description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <modules>
        <module>portfolio-common</module>
        <module>identity-service</module>
        <module>profile-service</module>
        <module>content-service</module>
        <module>portfolio-app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.portfolio</groupId>
                <artifactId>portfolio-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.portfolio</groupId>
                <artifactId>identity-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.portfolio</groupId>
                <artifactId>profile-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.portfolio</groupId>
                <artifactId>content-service</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
