# Copy to backend/.env (git-ignored) and fill in. Real environment variables override this file.

# --- MySQL --------------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=portfolio
# Prefer a dedicated user over root (see README, "Tạo user MySQL riêng")
DB_USERNAME=portfolio_app
DB_PASSWORD=change-me

# --- JWT ----------------------------------------------------------------------------------------
# At least 32 bytes. Generate one with:  openssl rand -base64 48   then write  base64:<value>
# Left empty = random key per start (sign-ins survive restarts anyway, but set it in production).
JWT_SECRET=

# --- Session ------------------------------------------------------------------------------------
# How long a sign-in lasts. Absolute: refreshing never extends it, after this the user signs in again.
SESSION_TTL=1d

# --- Google sign-in (optional) ------------------------------------------------------------------
# Google Cloud Console > Google Auth Platform > Clients > Create client (Web application)
# Authorized redirect URI:  http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Ownership ----------------------------------------------------------------------------------
# Emails that become ADMIN (the portfolio owner). Comma separated.
ADMIN_EMAILS=
# Demo convenience: the first account ever created becomes ADMIN. Set false once you own the site.
FIRST_USER_ADMIN=true

# --- Front-end / cookies ------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
# Keep true. Browsers accept Secure cookies on http://localhost; in production you must use HTTPS.
COOKIE_SECURE=true
